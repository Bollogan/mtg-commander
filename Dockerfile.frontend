# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY eslint.config.js ./
COPY index.html ./

# Install dependencies
RUN npm ci

# Empty by default = same-origin relative URLs. The nginx layer below reverse-proxies /api and
# /ws to the gateway, so the app works behind any host/tunnel with no CORS and no rebuild.
# Override only if you intentionally want the browser to hit a separate gateway origin.
ARG VITE_API_BASE=https://torresowo.myftp.org:7777/mtg-commander
ENV VITE_API_BASE=$VITE_API_BASE

# Optional: Google Sign-In client id (same value as the auth-service GOOGLE_CLIENT_ID).
# When empty, the "Continue with Google" button is simply not rendered.
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# Optional: Google AdSense publisher + slot ids. Ads only render when both are set.
ARG VITE_ADSENSE_CLIENT=""
ENV VITE_ADSENSE_CLIENT=$VITE_ADSENSE_CLIENT
ARG VITE_ADSENSE_SLOT_HOME=""
ENV VITE_ADSENSE_SLOT_HOME=$VITE_ADSENSE_SLOT_HOME

# Copy source
COPY src ./src
COPY public ./public

# Build
RUN npm run build

# Runtime stage — nginx serves the SPA and reverse-proxies the API + WebSocket
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
