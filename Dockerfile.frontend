# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY eslint.config.js ./
COPY index.html ./

# Install dependencies
RUN npm ci

ARG VITE_API_BASE=https://torresowo.myftp.org:7777/mtg-commander
ENV VITE_API_BASE=$VITE_API_BASE

# Copy source
COPY src ./src
COPY public ./public

# Build
RUN npm run build

# Runtime stage
FROM node:20-alpine

WORKDIR /app

# Install serve to run the built app
RUN npm install -g serve

# Copy built app from builder
COPY --from=builder /app/dist ./dist

EXPOSE 5173

CMD ["serve", "-s", "dist", "-l", "5173"]
