# Copy to backend/.env and fill in. Required by docker-compose.prod.yml (the `:?` vars).
# Generate strong random secrets, e.g.:  openssl rand -base64 48

# JWT signing secret — MUST be Base64 (the services Base64-decode it). Keep it private.
JWT_SECRET=

# Database passwords (any strong strings).
POSTGRES_PASSWORD=
MONGO_PASSWORD=

# ─── Optional ────────────────────────────────────────────────────────────────
# Google Sign-In: your Google Cloud OAuth Web client id. Set the SAME value in both:
#   - GOOGLE_CLIENT_ID        → auth-service verifies the token (backend)
#   - VITE_GOOGLE_CLIENT_ID   → baked into the frontend at build time (shows the button)
# Leave both blank to keep Google login disabled.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google AdSense (optional, baked into the frontend at build). Ads render only when both are set.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=

# Optional overrides
# POSTGRES_DB=mtg_deck_builder
# POSTGRES_USER=postgres
# MONGO_USER=mongo
