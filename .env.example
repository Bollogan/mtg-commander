# Base URL of the API gateway (defaults to http://localhost:8080 when unset).
VITE_API_BASE=http://localhost:8080

# Google Sign-In: your Google Cloud OAuth 2.0 "Web application" Client ID.
# When set, a "Continue with Google" button appears on /login and /register.
# Leave blank to keep the feature hidden. The same id must be set as GOOGLE_CLIENT_ID
# on the auth-service (see backend/docker-compose.yml).
VITE_GOOGLE_CLIENT_ID=

# Google AdSense (optional). Ads render ONLY when the publisher id AND the relevant slot id are
# both set. Get these from your AdSense dashboard once your site is approved.
# Trademark/policy caveats apply when monetizing MTG content — see DEPLOY.md.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
